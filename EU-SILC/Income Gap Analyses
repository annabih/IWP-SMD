*===============================================================================
* Tabel 5
*===============================================================================
local years "2018 2019 2020 2021 2022 2023 2024"
local cuts "0 50 100 200 300 400 500 700 1000"
local cut_labels `""0--50" "50--100" "100--200" "200--300" "300--400" "400--500" "500--700" "700--1000" "1000+""'

* Monatliche Gap-Variablen erstellen
gen gap_axi_post_m  = axi_ga / 12  if axi_ga  > 0 & !missing(axi_ga)
gen gap_iwpe_post_m = iwpe_ga / 12 if iwpe_ga > 0 & !missing(iwpe_ga)

* Brackets berechnen und speichern
foreach grp in axi iwpe {
    foreach yr of local years {

        quietly sum dwt if year == `yr' & !missing(gap_`grp'_post_m)
        local tot_`grp'_`yr' = r(sum)

        * 0-50
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 0   & gap_`grp'_post_m < 50   & !missing(gap_`grp'_post_m)
        local b1_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 50-100
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 50  & gap_`grp'_post_m < 100  & !missing(gap_`grp'_post_m)
        local b2_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 100-200
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 100 & gap_`grp'_post_m < 200  & !missing(gap_`grp'_post_m)
        local b3_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 200-300
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 200 & gap_`grp'_post_m < 300  & !missing(gap_`grp'_post_m)
        local b4_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 300-400
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 300 & gap_`grp'_post_m < 400  & !missing(gap_`grp'_post_m)
        local b5_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 400-500
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 400 & gap_`grp'_post_m < 500  & !missing(gap_`grp'_post_m)
        local b6_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 500-700
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 500 & gap_`grp'_post_m < 700  & !missing(gap_`grp'_post_m)
        local b7_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 700-1000
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 700 & gap_`grp'_post_m < 1000 & !missing(gap_`grp'_post_m)
        local b8_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
        * 1000+
        quietly sum dwt if year==`yr' & gap_`grp'_post_m >= 1000 & !missing(gap_`grp'_post_m)
        local b9_`grp'_`yr' = r(sum) / `tot_`grp'_`yr'' * 100
    }
}

