*******************************************************************************************************************************************************************************************
*** Titel: Income Gap Analyses
*** Date: 2026
*** Aim: Three output tables after Do-File 1 (Combined Poverty Analysis)
***      Table 2: Gap Distribution (pooled 2018-2024)
***      Table 3: Poverty Indicators by Year - large version with Delta
***      Table 4: Poverty Indicators by Year - small version with YoY
***      Table 5: Distribution of Monthly Income Gap by Year 
*** IMPORTANT: Run directly after Do-File 1 in the same Stata session
***            All locals (axipre_, axi_, iwpepre_, iwpe_, etc.) must be in memory
***            Data (ALL_POV_IND_SILC_PrePost_HH.dta) must still be loaded
*******************************************************************************************************************************************************************************************

di _n "=== STARTING DO-FILE 5: INCOME GAP TABLES ===" _n
di "Requires: Do-File 1 locals in memory + data still loaded"

* Verify key variables exist
foreach var in axipre_ga axi_ga iwpepre_ga iwpe_ga arop_excl_iwp_pre arop_excl_iwp iwp_emp_pre iwp_emp dwt year {
    capture confirm variable `var'
    if _rc != 0 {
        di as error "ERROR: Variable `var' not found. Run Do-File 1 first."
        exit 1
    }
}
di "Variable check passed." _n

local years "2018 2019 2020 2021 2022 2023 2024"

*===============================================================================
* TABLE 2: Distribution of Monthly Income Gap (pooled 2018-2024)
*===============================================================================
di _n "=== TABLE 2: Gap Distribution (pooled 2018-2024) ===" _n

* Monthly gap variables
capture drop gap_axi_pre_m gap_axi_post_m gap_iwp_pre_m gap_iwp_post_m
gen gap_axi_pre_m  = axipre_ga / 12  if axipre_ga  > 0 & !missing(axipre_ga)
gen gap_axi_post_m = axi_ga    / 12  if axi_ga     > 0 & !missing(axi_ga)
gen gap_iwp_pre_m  = iwpepre_ga / 12 if iwpepre_ga > 0 & !missing(iwpepre_ga)
gen gap_iwp_post_m = iwpe_ga   / 12  if iwpe_ga    > 0 & !missing(iwpe_ga)

* Pool indicator: 2018-2024, NO age restriction for axi (consistent with income section)
capture drop axi_pre_pool axi_post_pool iwp_pre_pool iwp_post_pool
gen axi_pre_pool  = (arop_excl_iwp_pre == 1) if inlist(year, 2018,2019,2020,2021,2022,2023,2024)
gen axi_post_pool = (arop_excl_iwp == 1)     if inlist(year, 2018,2019,2020,2021,2022,2023,2024)
gen iwp_pre_pool  = (iwp_emp_pre == 1)       if inlist(year, 2018,2019,2020,2021,2022,2023,2024)
gen iwp_post_pool = (iwp_emp == 1)           if inlist(year, 2018,2019,2020,2021,2022,2023,2024)

* Print results to screen
di _n "================================================"
di "TABLE 2: Income Gap Distribution (pooled 2018-2024)"
di "================================================"

foreach grp in "axi_pre" "axi_post" "iwp_pre" "iwp_post" {

    local gvar   "gap_`grp'_m"
    local cond   "`grp'_pool == 1 & !missing(`gvar')"

    if "`grp'" == "axi_pre"  local title "AROP w/o IWP -- Pre Transfer"
    if "`grp'" == "axi_post" local title "AROP w/o IWP -- Post Transfer"
    if "`grp'" == "iwp_pre"  local title "IWP Employees -- Pre Transfer"
    if "`grp'" == "iwp_post" local title "IWP Employees -- Post Transfer"

    di _n "--- `title' ---"

    quietly sum dwt if `cond'
    local tot = r(sum)

    foreach lo_hi in "0 50" "50 100" "100 200" "200 300" "300 400" "400 500" "500 700" "700 1000" {
        local lo = word("`lo_hi'", 1)
        local hi = word("`lo_hi'", 2)
        quietly sum dwt if `cond' & `gvar' >= `lo' & `gvar' < `hi'
        di %6.0f `lo' "--" %4.0f `hi' " EUR:  " %6.1f (`r(sum)'/`tot'*100) "%"
    }
    quietly sum dwt if `cond' & `gvar' >= 1000
    di "1000+     EUR:  " %6.1f (`r(sum)'/`tot'*100) "%"

    quietly sum `gvar' [aw=dwt] if `cond'
    di "Mean:          " %7.0f r(mean) " EUR"
    quietly _pctile `gvar' [pw=dwt] if `cond', p(50)
    di "Median:        " %7.0f r(r1)   " EUR"
}

* Store bracket values for LaTeX output
foreach grp in "axi_pre" "axi_post" "iwp_pre" "iwp_post" {
    local gvar "gap_`grp'_m"
    local cond "`grp'_pool == 1 & !missing(`gvar')"

    quietly sum dwt if `cond'
    local tot_`grp' = r(sum)

    local i = 0
    foreach lo_hi in "0 50" "50 100" "100 200" "200 300" "300 400" "400 500" "500 700" "700 1000" {
        local lo = word("`lo_hi'", 1)
        local hi = word("`lo_hi'", 2)
        local i = `i' + 1
        quietly sum dwt if `cond' & `gvar' >= `lo' & `gvar' < `hi'
        local b`i'_`grp' = r(sum) / `tot_`grp'' * 100
    }
    quietly sum dwt if `cond' & `gvar' >= 1000
    local b9_`grp' = r(sum) / `tot_`grp'' * 100

    quietly sum `gvar' [aw=dwt] if `cond'
    local mean_`grp' = round(r(mean), 1)
    quietly _pctile `gvar' [pw=dwt] if `cond', p(50)
    local median_`grp' = round(r(r1), 1)
}

* Write LaTeX Table 2
file open tex using "$output/table2_gap_distribution.tex", write replace

file write tex "\begin{table}[H]" _n
file write tex "\centering" _n
file write tex "\caption{Distribution of Monthly Income Gap to Poverty Threshold (2018--2024)}" _n
file write tex "\begin{tabular}{lrrrr}" _n
file write tex "\hline" _n
file write tex " & \multicolumn{2}{c}{AROP w/o IWP} & \multicolumn{2}{c}{IWP Employees} \\" _n
file write tex "Gap (EUR/Monat) & Pre Transfer & Post Transfer & Pre Transfer & Post Transfer \\" _n
file write tex "\hline" _n

foreach lo_hi_label in "0--50\,\euro{}" "50--100\,\euro{}" "100--200\,\euro{}" "200--300\,\euro{}" "300--400\,\euro{}" "400--500\,\euro{}" "500--700\,\euro{}" "700--1000\,\euro{}" {
    local i = `i'
}

local labels `"0--50\,\euro{}" "50--100\,\euro{}" "100--200\,\euro{}" "200--300\,\euro{}" "300--400\,\euro{}" "400--500\,\euro{}" "500--700\,\euro{}" "700--1000\,\euro{}" "1000+\,\euro{}"'

forvalues i = 1/9 {
    local lab: word `i' of `labels'
    file write tex "`lab'"
    foreach grp in "axi_pre" "axi_post" "iwp_pre" "iwp_post" {
        file write tex " & " %5.1f (`b`i'_`grp'') "\%"
    }
    file write tex " \\" _n
}

file write tex "\hline" _n
file write tex "Median"
foreach grp in "axi_pre" "axi_post" "iwp_pre" "iwp_post" {
    file write tex " & " %6.0f (`median_`grp'') "\,\euro{}"
}
file write tex " \\" _n
file write tex "Mean"
foreach grp in "axi_pre" "axi_post" "iwp_pre" "iwp_post" {
    file write tex " & " %6.0f (`mean_`grp'') "\,\euro{}"
}
file write tex " \\" _n
file write tex "\hline" _n
file write tex "\end{tabular}" _n
file write tex "\begin{flushleft}" _n
file write tex "\footnotesize" _n
file write tex "Notes: Share of poor population within each gap bracket. AROP w/o IWP: " _n
file write tex "at-risk-of-poverty excluding in-work poor. IWP Employees: in-work poor employees " _n
file write tex "(LES==3). Source: EU-SILC Austria, own calculations." _n
file write tex "\end{flushleft}" _n
file write tex "\end{table}" _n

file close tex
di "Table 2 saved: $output/table2_gap_distribution.tex"

* Cleanup temp variables
drop gap_axi_pre_m gap_axi_post_m gap_iwp_pre_m gap_iwp_post_m
drop axi_pre_pool axi_post_pool iwp_pre_pool iwp_post_pool

*===============================================================================
* TABLE 3: Poverty Indicators by Year - large version (with Delta pre/post)
*===============================================================================
di _n "=== TABLE 3: Poverty Indicators by Year (large) ===" _n

* Compute median gaps per year
foreach yr of local years {
    _pctile axipre_ga [pw=dwt] if year==`yr' & axipre_ga > 0 & !missing(axipre_ga), p(50)
    local medaxipre_`yr' = round(r(r1)/12, 1)
    _pctile axi_ga [pw=dwt] if year==`yr' & axi_ga > 0 & !missing(axi_ga), p(50)
    local medaxi_`yr' = round(r(r1)/12, 1)
    _pctile iwpepre_ga [pw=dwt] if year==`yr' & iwpepre_ga > 0 & !missing(iwpepre_ga), p(50)
    local mediwpepre_`yr' = round(r(r1)/12, 1)
    _pctile iwpe_ga [pw=dwt] if year==`yr' & iwpe_ga > 0 & !missing(iwpe_ga), p(50)
    local mediwpe_`yr' = round(r(r1)/12, 1)

    * Pre-Post reductions
    local axirate_red_`yr'  = round(`axipre_`yr'' - `axi_`yr'', 0.01)
    local axirate_redp_`yr' = round((`axipre_`yr'' - `axi_`yr'') / `axipre_`yr'' * 100, 0.01)
    local axigap_red_`yr'   = round(`axipre_gam_`yr'' - `axigam_`yr'', 1)
    local axigap_redp_`yr'  = round((`axipre_gam_`yr'' - `axigam_`yr'') / `axipre_gam_`yr'' * 100, 0.01)

    local iwperate_red_`yr'  = round(`iwpepre_`yr'' - `iwpe_`yr'', 0.01)
    local iwperate_redp_`yr' = round((`iwpepre_`yr'' - `iwpe_`yr'') / `iwpepre_`yr'' * 100, 0.01)
    local iwpegap_red_`yr'   = round(`iwpepre_gam_`yr'' - `iwpegam_`yr'', 1)
    local iwpegap_redp_`yr'  = round((`iwpepre_gam_`yr'' - `iwpegam_`yr'') / `iwpepre_gam_`yr'' * 100, 0.01)
}

