*==============================================================================
* Titel:  Deskriptive Datensatzbeschreibung  ->  LaTeX-Tabellen fuer Overleaf
* Aim:     booktabs-Tabellen mit EINER SPALTE PRO JAHR (2015-2024):
*          T1 Stichprobenuebersicht
*          T2 Zusammensetzung der Stichprobe (Trichter)
*          T3 Soziodemografische Struktur (Anteile)
*          T4 Deskriptive Statistik der Einkommensvariablen
*          T5 Mittleres Einkommen je Dezil (je Einkommensvariable)
* Logik:   wie im Haupt-Do-File -> nutzt $output/ALL_POV_IND_SILC_PrePost_HH.dta,
*          local years, foreach yr of local years, gewichtet mit dwt.
* Output:  "$descout/silc_descriptives.txt"  ->  in Overleaf einfuegen
* LaTeX:   benoetigt \usepackage{booktabs} und \usepackage{graphicx} (UTF-8)
*==============================================================================
clear all
set more off

*--- Pfade --------------------------------------------------------------------
global output  "D:\InWorkPoverty_SILC"    
global descout "D:\InWorkPoverty_SILC"

*--- Daten laden (gespeicherte Mikrodatei aus dem Haupt-Do-File) --------------
capture confirm file "$output/ALL_POV_IND_SILC_PrePost_HH.dta"
if _rc {
    di as error "Datei nicht gefunden. Bitte zuerst das Haupt-Do-File laufen lassen."
    exit 601
}
use "$output/ALL_POV_IND_SILC_PrePost_HH.dta", clear

*--- Jahre (wie im Haupt-Do-File) ---------------------------------------------
local years "2015 2016 2017 2018 2019 2020 2021 2022 2023 2024"

*--- Individuelles Bruttoerwerbseinkommen (optional, falls PY010G vorhanden) ---
local haveind = 0
capture confirm variable PY010G
if _rc == 0 {
    capture confirm string variable PY010G
    if _rc == 0 {
        replace PY010G = subinstr(PY010G, ",", ".", .)
        destring PY010G, replace force
    }
    gen double earn_emp = PY010G
    replace earn_emp = . if earn_emp <= 0
    replace earn_emp = . if age < 18 | age > 64
    label variable earn_emp "Bruttoerwerbseinkommen (PY010G), 18-64"
    local haveind = 1
    di as text "PY010G gefunden -> Einkommenstabellen um Individualebene erweitert."
}
else {
    di as text "PY010G nicht gefunden -> Einkommenstabellen nur auf Haushaltsebene."
}

*--- Ein Tag pro Haushalt und Jahr (fuer Haushaltszaehlung) --------------------
egen byte tag_hh = tag(year hh_id)

*--- Spaltenanzahl / Spaltenformat fuer die Jahres-Spalten --------------------
local ncol : word count `years'
local ncoltot = `ncol' + 1
local colspec "l"
forvalues j = 1/`ncol' { local colspec "`colspec'r" }

*==============================================================================
* OUTPUT-DATEI OEFFNEN
*==============================================================================
file open tex using "$descout/silc_descriptives.txt", write replace text
local eol "\\"

file write tex "% =====================================================" _n
file write tex "% Automatisch erzeugt aus EU-SILC AT (Stata)" _n
file write tex "% Benoetigt: \usepackage{booktabs}, \usepackage{graphicx}  (UTF-8)" _n
file write tex "% =====================================================" _n
file write tex "" _n

*==============================================================================
* TABELLE 1 - Stichprobenuebersicht
*==============================================================================
foreach yr of local years {
    qui count if year==`yr'
    local nobs_`yr' = r(N)
    qui count if year==`yr' & tag_hh
    local nhh_`yr' = r(N)
    qui sum dwt if year==`yr'
    local pop_`yr' = r(sum)/1000
}

file write tex "\begin{table}[htbp]\centering\footnotesize" _n
file write tex "\caption{Stichprobenuebersicht EU-SILC Oesterreich nach Erhebungsjahr}" _n
file write tex "\label{tab:silc_overview}" _n
file write tex "\setlength{\tabcolsep}{4pt}" _n
file write tex "\resizebox{\textwidth}{!}{%" _n
file write tex "\begin{tabular}{`colspec'}" _n
file write tex "\toprule" _n
local hdr "Indikator"
foreach yr of local years { local hdr "`hdr' & `yr'" }
file write tex "`hdr' `eol'" _n
file write tex "\midrule" _n

local row "Personen (ungew.)"
foreach yr of local years { local row "`row' & `=trim(strofreal(`nobs_`yr'',"%12.0fc"))'" }
file write tex "`row' `eol'" _n

local row "Haushalte (ungew.)"
foreach yr of local years { local row "`row' & `=trim(strofreal(`nhh_`yr'',"%12.0fc"))'" }
file write tex "`row' `eol'" _n

local row "Bevoelkerung (1.000, gew.)"
foreach yr of local years { local row "`row' & `=trim(strofreal(`pop_`yr'',"%12.0fc"))'" }
file write tex "`row' `eol'" _n

file write tex "\bottomrule" _n
file write tex "\end{tabular}}" _n
file write tex "\end{table}" _n
file write tex "" _n

*==============================================================================
* TABELLE 2 - Zusammensetzung der Stichprobe (Trichter)
*==============================================================================
foreach yr of local years {
    qui sum dwt if year==`yr'
    local pt_`yr' = r(sum)
    qui sum dwt if year==`yr' & age_group==2
    local pwa_`yr' = r(sum)
    qui sum dwt if year==`yr' & worker==1
    local pwk_`yr' = r(sum)
    qui sum dwt if year==`yr' & worker==1 & emp_status==3
    local pe_`yr' = r(sum)
}

file write tex "\begin{table}[htbp]\centering\footnotesize" _n
file write tex "\caption{Zusammensetzung der Stichprobe nach Jahr}" _n
file write tex "\label{tab:silc_funnel}" _n
file write tex "\setlength{\tabcolsep}{4pt}" _n
file write tex "\resizebox{\textwidth}{!}{%" _n
file write tex "\begin{tabular}{`colspec'}" _n
file write tex "\toprule" _n
local hdr ""
foreach yr of local years { local hdr "`hdr' & `yr'" }
file write tex "`hdr' `eol'" _n
file write tex "\midrule" _n

file write tex "\multicolumn{`ncoltot'}{l}{\textit{Bevoelkerung (1.000, gewichtet)}} `eol'" _n
local row "\quad Gesamt"
foreach yr of local years { local row "`row' & `=trim(strofreal(`pt_`yr''/1000,"%12.0fc"))'" }
file write tex "`row' `eol'" _n
local row "\quad im Erwerbsalter (18--64)"
foreach yr of local years { local row "`row' & `=trim(strofreal(`pwa_`yr''/1000,"%12.0fc"))'" }
file write tex "`row' `eol'" _n
local row "\quad erwerbstaetig (>6 Mon.)"
foreach yr of local years { local row "`row' & `=trim(strofreal(`pwk_`yr''/1000,"%12.0fc"))'" }
file write tex "`row' `eol'" _n
local row "\quad unselbst. beschaeftigt"
foreach yr of local years { local row "`row' & `=trim(strofreal(`pe_`yr''/1000,"%12.0fc"))'" }
file write tex "`row' `eol'" _n

file write tex "\addlinespace" _n
file write tex "\multicolumn{`ncoltot'}{l}{\textit{Anteil an Gesamtbevoelkerung (\%)}} `eol'" _n
local row "\quad im Erwerbsalter (18--64)"
foreach yr of local years { local row "`row' & `=trim(strofreal(100*`pwa_`yr''/`pt_`yr'',"%4.1f"))'" }
file write tex "`row' `eol'" _n
local row "\quad erwerbstaetig (>6 Mon.)"
foreach yr of local years { local row "`row' & `=trim(strofreal(100*`pwk_`yr''/`pt_`yr'',"%4.1f"))'" }
file write tex "`row' `eol'" _n
local row "\quad unselbst. beschaeftigt"
foreach yr of local years { local row "`row' & `=trim(strofreal(100*`pe_`yr''/`pt_`yr'',"%4.1f"))'" }
file write tex "`row' `eol'" _n

file write tex "\bottomrule" _n
file write tex "\end{tabular}}" _n
file write tex "{\footnotesize \textit{Anmerkung:} erwerbstaetig = >6 Monate, 18--64; unselbst. beschaeftigt = Erwerbstaetige mit emp\_status=3.}" _n
file write tex "\end{table}" _n
file write tex "" _n

*==============================================================================
* TABELLE 3 - Soziodemografische Struktur (Anteile in %)
*==============================================================================
foreach yr of local years {
    qui sum dwt if year==`yr'
    local pt_`yr' = r(sum)
    forvalues s=1/2 {
        qui sum dwt if year==`yr' & sex==`s'
        local shsex`s'_`yr' = 100*r(sum)/`pt_`yr''
    }
    forvalues a=1/3 {
        qui sum dwt if year==`yr' & age_group==`a'
        local shage`a'_`yr' = 100*r(sum)/`pt_`yr''
    }
    forvalues h=1/10 {
        qui sum dwt if year==`yr' & hh_type==`h'
        local shhh`h'_`yr' = 100*r(sum)/`pt_`yr''
    }
}

file write tex "\begin{table}[htbp]\centering\footnotesize" _n
file write tex "\caption{Soziodemografische Struktur nach Jahr (Anteile in \%)}" _n
file write tex "\label{tab:silc_demographics}" _n
file write tex "\setlength{\tabcolsep}{4pt}" _n
file write tex "\resizebox{\textwidth}{!}{%" _n
file write tex "\begin{tabular}{`colspec'}" _n
file write tex "\toprule" _n
local hdr ""
foreach yr of local years { local hdr "`hdr' & `yr'" }
file write tex "`hdr' `eol'" _n
file write tex "\midrule" _n

file write tex "\multicolumn{`ncoltot'}{l}{\textit{Geschlecht}} `eol'" _n
local sl1 "Maenner"
local sl2 "Frauen"
forvalues s=1/2 {
    local row "\quad `sl`s''"
    foreach yr of local years { local row "`row' & `=trim(strofreal(`shsex`s'_`yr'',"%4.1f"))'" }
    file write tex "`row' `eol'" _n
}
file write tex "\addlinespace" _n

file write tex "\multicolumn{`ncoltot'}{l}{\textit{Altersgruppen}} `eol'" _n
local al1 "Kinder (<18)"
local al2 "Erwerbsalter (18--64)"
local al3 "65+"
forvalues a=1/3 {
    local row "\quad `al`a''"
    foreach yr of local years { local row "`row' & `=trim(strofreal(`shage`a'_`yr'',"%4.1f"))'" }
    file write tex "`row' `eol'" _n
}
file write tex "\addlinespace" _n

file write tex "\multicolumn{`ncoltot'}{l}{\textit{Haushaltstyp}} `eol'" _n
local hl1 "1 Erwachsener"
local hl2 "1 Erwachsener + 1 Kind"
local hl3 "1 Erwachsener + 2+ Kinder"
local hl4 "2 Erwachsene"
local hl5 "2 Erwachsene + 1 Kind"
local hl6 "2 Erwachsene + 2 Kinder"
local hl7 "2 Erwachsene + 3+ Kinder"
local hl8 "3+ Erwachsene"
local hl9 "3+ Erwachsene mit Kindern"
local hl10 "Sonstige"
forvalues h=1/10 {
    local row "\quad `hl`h''"
    foreach yr of local years { local row "`row' & `=trim(strofreal(`shhh`h'_`yr'',"%4.1f"))'" }
    file write tex "`row' `eol'" _n
}

file write tex "\bottomrule" _n
file write tex "\end{tabular}}" _n
file write tex "{\footnotesize \textit{Anmerkung:} Anteile an der gewichteten Gesamtbevoelkerung des jeweiligen Jahres.}" _n
file write tex "\end{table}" _n
file write tex "" _n

*==============================================================================
* Einkommensvariablen fuer T4 / T5
*==============================================================================
local nv = 2
local v1 "eq_hh_post"
local L1 "Verf. HH-Einkommen (post), aequivalisiert"
local v2 "eq_hh_pre"
local L2 "Markteinkommen (pre), aequivalisiert"
if `haveind' {
    local nv = 3
    local v3 "earn_emp"
    local L3 "Bruttoerwerbseinkommen (PY010G), 18--64"
}

*==============================================================================
* TABELLE 4 - Deskriptive Statistik der Einkommensvariablen (EUR/Jahr)
*==============================================================================
forvalues i=1/`nv' {
    foreach yr of local years {
        qui sum `v`i'' [aw=dwt] if year==`yr' & !missing(`v`i'')
        local mn_`i'_`yr' = r(mean)
        _pctile `v`i'' [pw=dwt] if year==`yr' & !missing(`v`i''), p(10 50 90)
        local p10_`i'_`yr' = r(r1)
        local md_`i'_`yr'  = r(r2)
        local p90_`i'_`yr' = r(r3)
    }
}

file write tex "\begin{table}[htbp]\centering\footnotesize" _n
file write tex "\caption{Deskriptive Statistik der Einkommensvariablen nach Jahr (gewichtet, EUR/Jahr)}" _n
file write tex "\label{tab:silc_income_summary}" _n
file write tex "\setlength{\tabcolsep}{4pt}" _n
file write tex "\resizebox{\textwidth}{!}{%" _n
file write tex "\begin{tabular}{`colspec'}" _n
file write tex "\toprule" _n
local hdr ""
foreach yr of local years { local hdr "`hdr' & `yr'" }
file write tex "`hdr' `eol'" _n
file write tex "\midrule" _n

forvalues i=1/`nv' {
    file write tex "\multicolumn{`ncoltot'}{l}{\textit{`L`i''}} `eol'" _n
    local row "\quad Mittelwert"
    foreach yr of local years { local row "`row' & `=cond(missing(`mn_`i'_`yr''),"--",trim(strofreal(`mn_`i'_`yr'',"%12.0fc")))'" }
    file write tex "`row' `eol'" _n
    local row "\quad Median"
    foreach yr of local years { local row "`row' & `=cond(missing(`md_`i'_`yr''),"--",trim(strofreal(`md_`i'_`yr'',"%12.0fc")))'" }
    file write tex "`row' `eol'" _n
    local row "\quad p10"
    foreach yr of local years { local row "`row' & `=cond(missing(`p10_`i'_`yr''),"--",trim(strofreal(`p10_`i'_`yr'',"%12.0fc")))'" }
    file write tex "`row' `eol'" _n
    local row "\quad p90"
    foreach yr of local years { local row "`row' & `=cond(missing(`p90_`i'_`yr''),"--",trim(strofreal(`p90_`i'_`yr'',"%12.0fc")))'" }
    file write tex "`row' `eol'" _n
    if `i' < `nv' file write tex "\addlinespace" _n
}

file write tex "\bottomrule" _n
file write tex "\end{tabular}}" _n
file write tex "{\footnotesize \textit{Anmerkung:} Personengewichtet (dwt). HH-Einkommen OECD-aequivalisiert; Individualeinkommen nicht aequivalisiert.}" _n
file write tex "\end{table}" _n
file write tex "" _n

*==============================================================================
* TABELLE 5 - Mittleres Einkommen je Dezil (je Variable eine Tabelle)
*==============================================================================
forvalues i=1/`nv' {

    * Dezilmittelwerte je Jahr berechnen (eigene Dezilgrenzen je Jahr)
    foreach yr of local years {
        _pctile `v`i'' [pw=dwt] if year==`yr' & !missing(`v`i''), p(10 20 30 40 50 60 70 80 90)
        forvalues k=1/9 { local cut`k' = r(r`k') }
        tempvar dec
        gen byte `dec' = .
        replace `dec' = 1 if year==`yr' & `v`i'' <= `cut1' & !missing(`v`i'')
        forvalues k=2/9 {
            local km1 = `k' - 1
            replace `dec' = `k' if year==`yr' & `v`i'' > `cut`km1'' & `v`i'' <= `cut`k''
        }
        replace `dec' = 10 if year==`yr' & `v`i'' > `cut9' & !missing(`v`i'')
        forvalues d=1/10 {
            qui sum `v`i'' [aw=dwt] if `dec'==`d'
            local md_`i'_`yr'_`d' = r(mean)
        }
        drop `dec'
    }

    file write tex "\begin{table}[htbp]\centering\footnotesize" _n
    file write tex "\caption{Mittleres Einkommen je Dezil nach Jahr -- `L`i'' (gewichtet, EUR/Jahr)}" _n
    file write tex "\label{tab:silc_deciles_`i'}" _n
    file write tex "\setlength{\tabcolsep}{4pt}" _n
    file write tex "\resizebox{\textwidth}{!}{%" _n
    file write tex "\begin{tabular}{`colspec'}" _n
    file write tex "\toprule" _n
    local hdr "Dezil"
    foreach yr of local years { local hdr "`hdr' & `yr'" }
    file write tex "`hdr' `eol'" _n
    file write tex "\midrule" _n
    forvalues d=1/10 {
        local row "D`d'"
        foreach yr of local years { local row "`row' & `=cond(missing(`md_`i'_`yr'_`d''),"--",trim(strofreal(`md_`i'_`yr'_`d'',"%12.0fc")))'" }
        file write tex "`row' `eol'" _n
    }
    file write tex "\bottomrule" _n
    file write tex "\end{tabular}}" _n
    file write tex "{\footnotesize \textit{Anmerkung:} Jedes Dezil = rund 10\% der gewichteten Personen; Dezilgrenzen je Jahr separat.}" _n
    file write tex "\end{table}" _n
    file write tex "" _n
}

*==============================================================================
file close tex
di as result "Fertig: $descout/silc_descriptives.txt"
*==============================================================================
